msgid ""
msgstr ""
"Project-Id-Version: presize\n"
"Language: ru\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgid "Top left"
msgstr "Слева сверху"

msgid "Top"
msgstr "Сверху"

msgid "Top right"
msgstr "Справа сверху"

msgid "Left"
msgstr "Слева"

msgid "Center"
msgstr "По центру"

msgid "Right"
msgstr "Справа"

msgid "Bottom left"
msgstr "Слева снизу"

msgid "Bottom"
msgstr "Снизу"

msgid "Bottom right"
msgstr "Справа снизу"

msgid "Where it is now"
msgstr "Где оно сейчас"

msgid "Add a preset"
msgstr "Добавить предустановку"

msgid "Presets"
msgstr "Предустановки"

msgid "Press a preset’s shortcut and the active window takes that size and place. Click a preset to change it."
msgstr "Нажмите сочетание клавиш предустановки, и активное окно примет этот размер и положение. Нажмите на предустановку, чтобы изменить её."

msgid "No shortcut"
msgstr "Нет сочетания"

msgid "Unnamed preset"
msgstr "Предустановка без имени"

msgid "% of screen"
msgstr "% экрана"

msgid "px"
msgstr "px"

msgid "Name"
msgstr "Название"

msgid "Measure size in"
msgstr "Единицы размера"

msgid "Pixels"
msgstr "Пиксели"

msgid "Percent of screen"
msgstr "Проценты экрана"

msgid "Width"
msgstr "Ширина"

msgid "Height"
msgstr "Высота"

msgid "Position the window"
msgstr "Размещать окно"

msgid "Off: the window only changes size and stays where it is"
msgstr "Выключено: окно только меняет размер и остаётся на месте"

msgid "Put the window"
msgstr "Поместить окно"

msgid "Shortcut"
msgstr "Сочетание клавиш"

msgid "Click here, then press the keys you want"
msgstr "Нажмите здесь, затем нажмите нужные клавиши"

msgid "Remove this preset"
msgstr "Удалить эту предустановку"

msgid "Drag to reorder"
msgstr "Перетащите, чтобы изменить порядок"

msgid "Already used by the preset “%s”"
msgstr "Уже используется предустановкой «%s»"

msgid "Already used by GNOME for “%s”"
msgstr "Уже используется GNOME для «%s»"

msgid "Already used by your own GNOME shortcut “%s”"
msgstr "Уже используется вашим сочетанием GNOME «%s»"

msgid "New shortcut"
msgstr "Новое сочетание"

msgid "Press the keys you want to use"
msgstr "Нажмите клавиши, которые хотите использовать"

msgid "Backspace removes the shortcut, Escape cancels"
msgstr "Backspace удаляет сочетание, Escape отменяет"

msgid "Shortcuts already used by the system cannot be assigned here."
msgstr "Сочетания, уже занятые системой, здесь назначить нельзя."

msgid "Try a different combination."
msgstr "Попробуйте другую комбинацию."
