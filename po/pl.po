msgid "Top left"
msgstr "Lewy górny róg"

msgid "Top"
msgstr "Góra"

msgid "Top right"
msgstr "Prawy górny róg"

msgid "Left"
msgstr "Lewo"

msgid "Center"
msgstr "Środek"

msgid "Right"
msgstr "Prawo"

msgid "Bottom left"
msgstr "Lewy dolny róg"

msgid "Bottom"
msgstr "Dół"

msgid "Bottom right"
msgstr "Prawy dolny róg"

msgid "Where it is now"
msgstr "Tam, gdzie jest"

msgid "Add a preset"
msgstr "Dodaj ustawienie"

msgid "Presets"
msgstr "Ustawienia okien"

msgid "Press a preset’s shortcut and the active window takes that size and place. Click a preset to change it."
msgstr "Wciśnij skrót, a aktywne okno przyjmie zapisany rozmiar i miejsce. Kliknij pozycję na liście, aby ją zmienić."

msgid "No shortcut"
msgstr "Brak skrótu"

msgid "Unnamed preset"
msgstr "Bez nazwy"

msgid "% of screen"
msgstr "% ekranu"

msgid "px"
msgstr "px"

msgid "Name"
msgstr "Nazwa"

msgid "Measure size in"
msgstr "Rozmiar podany w"

msgid "Pixels"
msgstr "Pikselach"

msgid "Percent of screen"
msgstr "Procentach ekranu"

msgid "Width"
msgstr "Szerokość"

msgid "Height"
msgstr "Wysokość"

msgid "Leave the window where it is"
msgstr "Zostaw okno tam, gdzie jest"

msgid "Only change its size"
msgstr "Zmień tylko rozmiar"

msgid "Put the window"
msgstr "Umieść okno"

msgid "Shortcut"
msgstr "Skrót klawiszowy"

msgid "Click here, then press the keys you want"
msgstr "Kliknij tutaj i wciśnij wybrane klawisze"

msgid "Remove this preset"
msgstr "Usuń to ustawienie"

msgid "New shortcut"
msgstr "Nowy skrót"

msgid "Press the keys you want to use"
msgstr "Wciśnij klawisze, których chcesz używać"

msgid "Backspace removes the shortcut, Escape cancels"
msgstr "Backspace usuwa skrót, Escape anuluje"

msgid "Drag to reorder"
msgstr "Przeciągnij, aby zmienić kolejność"

msgid "Already used by the preset “%s”"
msgstr "Tego skrótu używa już ustawienie „%s”"

msgid "Already used by GNOME for “%s”"
msgstr "Tego skrótu używa już GNOME: „%s”"

msgid "Already used by your own GNOME shortcut “%s”"
msgstr "Tego skrótu używa już Twój własny skrót GNOME „%s”"

msgid "Try a different combination."
msgstr "Wybierz inną kombinację."

msgid "If nothing happens, GNOME already uses that combination."
msgstr "Jeśli nic się nie dzieje, GNOME już używa tej kombinacji."
