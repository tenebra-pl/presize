msgid "Top left"
msgstr "Oben links"

msgid "Top"
msgstr "Oben"

msgid "Top right"
msgstr "Oben rechts"

msgid "Left"
msgstr "Links"

msgid "Center"
msgstr "Mitte"

msgid "Right"
msgstr "Rechts"

msgid "Bottom left"
msgstr "Unten links"

