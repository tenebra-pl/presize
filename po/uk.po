msgid "Top left"
msgstr "Зліва вгорі"

msgid "Top"
msgstr "Вгорі"

msgid "Top right"
msgstr "Справа вгорі"

msgid "Left"
msgstr "Зліва"

msgid "Center"
msgstr "По центру"

msgid "Right"
msgstr "Справа"

msgid "Bottom left"
msgstr "Зліва внизу"

msgid "Bottom"
msgstr "Внизу"

msgid "Bottom right"
msgstr "Справа внизу"

msgid "Where it is now"
msgstr "Де воно зараз"

msgid "Add a preset"
msgstr "Додати набір"

msgid "Presets"
msgstr "Набори"

msgid "Press a preset’s shortcut and the active window takes that size and place. Click a preset to change it."
msgstr "Натисніть сполучення клавіш набору, і активне вікно набуде цього розміру та положення. Натисніть на набір, щоб змінити його."

msgid "No shortcut"
msgstr "Немає сполучення"

msgid "Unnamed preset"
msgstr "Набір без назви"

msgid "% of screen"
msgstr "% екрана"

msgid "px"
msgstr "px"

msgid "Name"
msgstr "Назва"

msgid "Measure size in"
msgstr "Одиниці розміру"

msgid "Pixels"
msgstr "Пікселі"

msgid "Percent of screen"
msgstr "Відсотки екрана"

msgid "Width"
msgstr "Ширина"

msgid "Height"
msgstr "Висота"

msgid "Position the window"
msgstr "Розміщувати вікно"

msgid "Off: the window only changes size and stays where it is"
msgstr "Вимкнено: вікно лише змінює розмір і залишається на місці"

msgid "Put the window"
msgstr "Помістити вікно"

msgid "Shortcut"
msgstr "Сполучення клавіш"

msgid "Click here, then press the keys you want"
msgstr "Натисніть тут, а потім потрібні клавіші"

msgid "Remove this preset"
msgstr "Вилучити цей набір"

msgid "Drag to reorder"
msgstr "Перетягніть, щоб змінити порядок"

msgid "Already used by the preset “%s”"
msgstr "Уже використовується набором «%s»"

msgid "Already used by GNOME for “%s”"
msgstr "Уже використовується GNOME для «%s»"

msgid "Already used by your own GNOME shortcut “%s”"
msgstr "Уже використовується вашим сполученням GNOME «%s»"

msgid "New shortcut"
msgstr "Нове сполучення"

msgid "Press the keys you want to use"
msgstr "Натисніть клавіші, які хочете використовувати"

msgid "Backspace removes the shortcut, Escape cancels"
msgstr "Backspace вилучає сполучення, Escape скасовує"

msgid "Shortcuts already used by the system cannot be assigned here."
msgstr "Сполучення, які вже зайняті системою, тут призначити не можна."

msgid "Try a different combination."
msgstr "Спробуйте іншу комбінацію."
