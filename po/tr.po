msgid "Top left"
msgstr "Sol üst"

msgid "Top"
msgstr "Üst"

msgid "Top right"
msgstr "Sağ üst"

msgid "Left"
msgstr "Sol"

msgid "Center"
msgstr "Orta"

msgid "Right"
msgstr "Sağ"

msgid "Bottom left"
msgstr "Sol alt"

msgid "Bottom"
msgstr "Alt"

msgid "Bottom right"
msgstr "Sağ alt"

msgid "Where it is now"
msgstr "Şu anda olduğu yerde"

msgid "Add a preset"
msgstr "Ön ayar ekle"

msgid "Presets"
msgstr "Ön ayarlar"

msgid "Press a preset’s shortcut and the active window takes that size and place. Click a preset to change it."
msgstr "Bir ön ayarın kısayoluna basın, etkin pencere o boyutu ve konumu alır. Değiştirmek için bir ön ayara tıklayın."

msgid "No shortcut"
msgstr "Kısayol yok"

msgid "Unnamed preset"
msgstr "Adsız ön ayar"

msgid "% of screen"
msgstr "% ekran"

msgid "px"
msgstr "px"

msgid "Name"
msgstr "Ad"

msgid "Measure size in"
msgstr "Boyut birimi"

msgid "Pixels"
msgstr "Piksel"

msgid "Percent of screen"
msgstr "Ekran yüzdesi"

msgid "Width"
msgstr "Genişlik"

msgid "Height"
msgstr "Yükseklik"

msgid "Position the window"
msgstr "Pencereyi konumlandır"

msgid "Off: the window only changes size and stays where it is"
msgstr "Kapalı: pencere yalnızca boyut değiştirir ve yerinde kalır"

msgid "Put the window"
msgstr "Pencereyi yerleştir"

msgid "Shortcut"
msgstr "Kısayol"

msgid "Click here, then press the keys you want"
msgstr "Buraya tıklayın, sonra istediğiniz tuşlara basın"

msgid "Remove this preset"
msgstr "Bu ön ayarı kaldır"

msgid "Drag to reorder"
msgstr "Sıralamak için sürükleyin"

msgid "Already used by the preset “%s”"
msgstr "“%s” ön ayarı tarafından zaten kullanılıyor"

msgid "Already used by GNOME for “%s”"
msgstr "GNOME tarafından “%s” için zaten kullanılıyor"

msgid "Already used by your own GNOME shortcut “%s”"
msgstr "Kendi GNOME kısayolunuz “%s” tarafından zaten kullanılıyor"

msgid "New shortcut"
msgstr "Yeni kısayol"

msgid "Press the keys you want to use"
msgstr "Kullanmak istediğiniz tuşlara basın"

msgid "Backspace removes the shortcut, Escape cancels"
msgstr "Backspace kısayolu kaldırır, Escape iptal eder"

msgid "Shortcuts already used by the system cannot be assigned here."
msgstr "Sistem tarafından kullanılan kısayollar buraya atanamaz."

msgid "Try a different combination."
msgstr "Başka bir kombinasyon deneyin."
