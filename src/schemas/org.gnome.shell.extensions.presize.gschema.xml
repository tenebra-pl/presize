<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.presize" path="/org/gnome/shell/extensions/presize/">
    <key name="presets" type="as">
      <default>[
        '{"name":"Small","width":1280,"height":800,"unit":"px","position":"center","shortcut":"&lt;Control&gt;F1"}',
        '{"name":"Medium","width":1600,"height":1000,"unit":"px","position":"center","shortcut":"&lt;Control&gt;F2"}',
        '{"name":"Large","width":1920,"height":1200,"unit":"px","position":"center","shortcut":"&lt;Control&gt;F3"}',
        '{"name":"Almost full","width":90,"height":90,"unit":"%","position":"center","shortcut":"&lt;Control&gt;F4"}'
      ]</default>
      <summary>Presets</summary>
      <description>Each entry is a JSON object: name, width, height, unit ("px" or "%" of the work area), position (center, top-left, top, top-right, left, right, bottom-left, bottom, bottom-right, keep), shortcut (GTK accelerator string, empty for none).</description>
    </key>
  </schema>
